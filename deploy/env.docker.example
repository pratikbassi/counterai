# Example environment for Docker Compose (`docker-compose.yml`).
# Copy to repo-root `.env` and adjust secrets (chmod 600 .env).

# Postgres (Compose `db` service)
POSTGRES_USER=counterai
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=counterai_production

# Rails (required in production)
RAILS_MASTER_KEY=paste-backend-config-master-key-here

# Optional: comma-separated origins for browser CORS (your static frontend origins)
FRONTEND_ORIGINS=https://app.example.com

# HTTPS with `docker compose --profile tls up` — set DNS A/AAAA first
# API_HOST=api.example.com

# Match Puma thread count to DB pool (`config/database.yml` uses RAILS_MAX_THREADS)
RAILS_MAX_THREADS=5

# Defaults for Solid Queue in single-container deploy
SOLID_QUEUE_IN_PUMA=true
