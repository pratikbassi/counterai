# Copy to `.env` at the repository root (see .gitignore). Loaded by Rails
# (backend/config/initializers/repo_root_dotenv.rb) and the Python downloader.

# Maximum URL length (bytes) for DownloaderJob and downloader CLI validation.
DOWNLOADER_MAX_URL_BYTES=8192

# Optional: override shared Instagram permalink rules (default: ../config/instagram_post_url.json from backend).
# INSTAGRAM_POST_URL_CONFIG=/absolute/path/to/instagram_post_url.json
