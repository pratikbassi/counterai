# Copy to `.env` at the repository root (see .gitignore). Loaded early by Rails
# (`backend/config/boot.rb`, with overwrite so file values beat stale shell vars).

# Maximum URL length (bytes) for DownloaderJob and downloader CLI validation.
DOWNLOADER_MAX_URL_BYTES=8192

# Optional: override shared Instagram permalink rules (default: ../config/instagram_post_url.json from backend).
# INSTAGRAM_POST_URL_CONFIG=/absolute/path/to/instagram_post_url.json

# Local PostgreSQL (see `backend/config/database.yml` `local` anchor). Quote if needed:
# PGPASSWORD='your-password-here'
PGUSER=postgres
PGPASSWORD=

# Classifier subprocess (Rails `DetectorJob` → `model/classify.py`). Local defaults assume
# monorepo layout: Rails in `backend/`, sibling `model/`.
CLASSIFIER_PYTHON=
CLASSIFIER_SCRIPT=
CLASSIFIER_CHECKPOINT=
CLASSIFIER_DEVICE=cpu
CLASSIFIER_TIMEOUT_SEC=60

# Comma-separated browser origins allowed for API CORS in production (e.g. https://app.example.com).
# Development still permits http://localhost:5173 regardless.
FRONTEND_ORIGINS=
